# Environment Profile ('dev', 'test_prod', 'prod', 'production')
APP_ENV=test_prod
LOG_LEVEL=INFO
MAX_CONCURRENCY=10

# Azure AD / Microsoft Graph API Configuration
AZURE_TENANT_ID=your_azure_tenant_id_here
AZURE_CLIENT_ID=your_azure_client_id_here
AZURE_CLIENT_SECRET=your_azure_client_secret_here
GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_PAGE_SIZE=50

# Mock Server Configuration (for 'dev' mode)
MOCK_SERVER_URL=http://localhost:3000

# Email Preprocessing & Cleaner Configuration
CLEANER_STRIP_SIGNATURES=true
CLEANER_MAX_BLANK_LINES=1
CLEANER_PRESERVE_LINKS=false

# LLM Context Compressor & LLMLingua Configuration
USE_LLMLINGUA=true
LLMLINGUA_MODEL=microsoft/llmlingua-2-xlm-roberta-large-meetingbank
LLMLINGUA_DEVICE=cpu
LLMLINGUA_RATE=0.75
COMPRESSOR_MAX_FULL_BODY_CHARS=300
COMPRESSOR_RECENT_FULL_COUNT=2
COMPRESSOR_ACTIVATION_LENGTH=100
COMPRESSOR_TOKEN_BUDGET_RATIO=1.8
COMPRESSOR_KEEP_FIRST_SENTENCE=true

# NVIDIA AI Cloud / NIM Configuration (for synthetic email generator tool)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_CONCURRENCY=1
LLM_REQUEST_DELAY=0.5
