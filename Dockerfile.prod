 FROM ghcr.io/astral-sh/uv:0.6.5-python3.12-bookworm-slim AS builder

    WORKDIR /app

    ENV UV_COMPILE_BYTECODE=1 \
        UV_LINK_MODE=copy

    COPY pyproject.toml uv.lock ./

    # Install production dependencies ONLY (no dev extras)
    RUN --mount=type=cache,target=/root/.cache/uv \
        uv sync --frozen --no-install-project --no-dev

    # Final runtime image: Lean & production-ready (no tools/, no tests/)
    FROM python:3.12-slim-bookworm AS runner

    WORKDIR /app

    RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        && rm -rf /var/lib/apt/lists/*

    # Copy virtual environment and core source ONLY
    COPY --from=builder /app/.venv /app/.venv
    COPY src ./src
    COPY pyproject.toml ./

    # Set environment variables for production
    ENV PATH="/app/.venv/bin:$PATH" \
        PYTHONUNBUFFERED=1 \
        PYTHONDONTWRITEBYTECODE=1 \
        APP_ENV=test_prod \
        EMAIL_PROVIDER=microsoft

    CMD ["python", "-m", "intelligent_email_service.pipeline"]