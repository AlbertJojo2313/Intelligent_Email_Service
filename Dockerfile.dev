FROM ghcr.io/astral-sh/uv:0.6.5-python3.12-bookworm-slim AS builder

    WORKDIR /app

    ENV UV_COMPILE_BYTECODE=1 \
        UV_LINK_MODE=copy

    COPY pyproject.toml uv.lock ./

    RUN --mount=type=cache,target=/root/.cache/uv \
        uv sync --frozen --no-install-project --no-dev

    COPY src ./src
    COPY tools ./tools
    COPY README.md ./

    # Install root package and all dev extras (faker, pytest, etc.)
    RUN --mount=type=cache,target=/root/.cache/uv \
        uv sync --frozen --all-extras

    # Runtime image for local dev and mock testing
    FROM python:3.12-slim-bookworm AS runner

    WORKDIR /app

    RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        && rm -rf /var/lib/apt/lists/*

    # Copy venv, core src, AND dev tools
    COPY --from=builder /app/.venv /app/.venv
    COPY --from=builder /app/src /app/src
    COPY --from=builder /app/tools /app/tools
    COPY --from=builder /app/pyproject.toml /app/pyproject.toml

    # Set environment variables for development
    ENV PATH="/app/.venv/bin:$PATH" \
        PYTHONUNBUFFERED=1 \
        PYTHONDONTWRITEBYTECODE=1 \
        APP_ENV=dev \
        EMAIL_PROVIDER=mock

    CMD ["python", "-m", "intelligent_email_service.pipeline"]